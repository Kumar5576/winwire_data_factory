{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "winwiredatafactory"
		},
		"LS_MySql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_MySql'"
		},
		"ls_azurestorge_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'ls_azurestorge'"
		},
		"winwireDataLakeStorage_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'winwireDataLakeStorage'"
		},
		"LS_MySql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "localhost"
		},
		"LS_MySql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "bv"
		},
		"LS_MySql_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "root"
		},
		"winwireDataLakeStorage_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://winwirestorage2.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "winwiredatafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_MySql_password": {
						"value": "[parameters('LS_MySql_password')]"
					},
					"ls_azurestorge_connectionString": {
						"value": "[parameters('ls_azurestorge_connectionString')]"
					},
					"winwireDataLakeStorage_accountKey": {
						"value": "[parameters('winwireDataLakeStorage_accountKey')]"
					},
					"LS_MySql_properties_typeProperties_server": {
						"value": "[parameters('LS_MySql_properties_typeProperties_server')]"
					},
					"LS_MySql_properties_typeProperties_database": {
						"value": "[parameters('LS_MySql_properties_typeProperties_database')]"
					},
					"LS_MySql_properties_typeProperties_username": {
						"value": "[parameters('LS_MySql_properties_typeProperties_username')]"
					},
					"winwireDataLakeStorage_properties_typeProperties_url": {
						"value": "[parameters('winwireDataLakeStorage_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "winwiredatafactory_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'winwiredatafactory_ArmTemplate_0')]"
			]
		}
	]
}